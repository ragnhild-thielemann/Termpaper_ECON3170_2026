Det første vi gjør, er at vi imporerer alle pakkene vi strenger for prosjektet vårt. Disse kjører vi en gang, slik at de er importert når vi fortsetter å jobbe.
```{r}
#| echo: false
#| 
library(httr); library(jsonlite); library(dplyr); library(tidyr); library(lubridate); library(zoo); library(rugarch); library(plm); library(readr); library(vars) ; library(tidyverse)

```

## Innsamling av data



### Fyllingsgrad 

Vi skal bruke API-er til å innhente dataen vi skal bruke for prosjektet. For å finne den historiske fyllingsgraden i vannmagasinene bruker vi APIet til NVE. Dette er på et JSON-format, som leses inn som en tibble. Deretter behandler vi datasettet ved hjelp av *tidyverse*, slik at vi får variablene vi trenger for vidre arbeid. 




```{r}

hent_vannreservoar <- function(start_year = 1950,
                           end_year = 2024,
                           areas = c("NO1", "NO2", "NO3", "NO4", "NO5")) { #har initialverdier for funksjonen, som kan endres om ønskelig
  
  # URL til NVE sitt API
  url <- paste0(
    "https://biapi.nve.no/magasinstatistikk/",
    "api/Magasinstatistikk/HentOffentligData"
  )
  
  # Gjør dataen om til en tibble, slik at vi kan behandle det som en tibble
  data <- jsonlite::fromJSON(url)
  
  # Bearbeider datasettet, slik at vi får det på et tidy format
  reservoarer <- data |>
    dplyr::filter(
      iso_aar >= start_year,
      iso_aar <= end_year
    ) |>
    dplyr::mutate(
      prisomrade = paste0("NO", omrnr),
    ) |>
    dplyr::filter(
      prisomrade %in% areas
    ) |>
    dplyr::select(
      dato = dato_Id,
      prisomrade,
      fyllingsgrad,
      fyllingsgrad_forrige_uke
    ) |>
    dplyr::mutate(endring = fyllingsgrad-fyllingsgrad_forrige_uke)|>
    dplyr::arrange(
      dato,
      prisomrade
    )
  
  return(reservoarer)
}

vannreservoar <- hent_vannreservoar()
View(vannreservoar)

```

### Nedbørsdata

For å få tilgang til nedbørsdataen fra metrologisk institutt, må vi ha en tilgangsnøkkel. Dette får vi ved å logge inn med eposten vår. Vi kjører APIene 1 gang, også jobber vi vidre med datasettene. 
```{r}
key <- "975782f3-bb04-423d-a49b-53b249a9e0da"


hent_nedbor_tonstad <- function(key,
                               start_date = "1995-01-01",
                               end_date = "2024-12-31",
                               antall_stasjoner = 5) {
  

  
  url_stasjoner <- "https://frost.met.no/sources/v0.jsonld"
  
  response_stasjoner <- GET(
  url_stasjoner,
  authenticate(key, ""),
  query = list(
    types = "SensorSystem",
    geometry = "nearest(POINT(6.716 58.662))",
    nearestmaxcount = antall_stasjoner
  )
)
  
  stop_for_status(response_stasjoner) #skjekker at det er en ikke-tom API
  
  stasjoner_for_observasjon <- httr::content(
    response_stasjoner,
    as = "parsed"
  )$data #henter inn innholdet fra APIet som en JSONfil, og gjør det om til en liste for R (de relevante verdiene ligger i kolonnen data i JSON-filen). 
  
  
  # Gjør stasjonsinformasjonen om til tibble
  stations <- purrr::map_dfr(
    stasjoner_for_observasjon, #Bruker de gitte værstasjonene for observasjon
    function(x) {
      
      tibble(
        station = x$id,
        navn = x$name,
        avstand_km = x$distance,
        hoyde_moh = x$masl,
        kommune = x$municipality
      )
      
    }
  )
  
  
#bygger en url til API-et for å hente ut værdataen
  observations_url <- "https://frost.met.no/observations/v0.jsonld" 
  
  ver_response <- GET(
    observations_url,
    authenticate(key, ""),
    query = list(
      sources = paste(stations$station, collapse = ","),
      referencetime = paste0(start_date, "/", end_date),
      elements = "sum(precipitation_amount P1D)",
      timeoffsets = "default",
      levels = "default"
    )
  )
  
  stop_for_status(ver_response) #stopper dersom APIen er tom

  data <- httr::content(
    ver_response,
    as = "parsed"
  )$data
  
  
  
 nedbor <- purrr::map_dfr(
  data,
  function(x) {
    tibble(
      station = x$sourceId,
      dato = as.Date(x$referenceTime),
      nedbor_mm = purrr::map_dbl(
        x$observations,
        ~ as.numeric(.x$value)
      ))
  }
  
 )
  return(nedbor)
}

nedbor <- (hent_nedbor_tonstad(key))
View(nedbor)


```

## Tidseriediagram med vannreservoarene

Vi lager et tidsseriediagram med vannreservoarene. Da dette varierer periodisk, ønsker vi å lage et spagettiplott. Vi ser først på prisområde NO1, for å gjøre dette enklere. 
```{r}
library(tidyverse)
library(lubridate)

p1 <- vannreservoar |>
  
  
  mutate(
    year = year(dato),
    dag = yday(dato)
  )|>
  mutate(gjennomsnitt_fylling = mean(fyllingsgrad),.by = dag)

ggplot(p1, aes(
  x = dag,
  y = gjennomsnitt_fylling,
  group = year,
  color = factor(year)
)) +
  geom_line() +
  labs(
    x = "Tidspunkt pa aret",
    y = "Fyllingsgrad (%)",
    title = "Gjennomsnittlig magasinfylling i Norge"
  ) +
  theme_minimal() + 
   scale_x_date(
    date_breaks = "4 month",
    date_labels = "%b"
  )




```


|Kabel | Innføringsår| Land| Kapasitet|
|---------|-----------|------|-----|
|NorNed| 2008| Nederland| 700 MW|
|Cross-Skagerak 4| 2014 | Danmark|1700 MW|
|NordLink| 2020|Tyskland|1400 MW|
|North Sea Link| 2021|Storbritannia|1400 MW|

Vi ser da på gjennomsnittlig fyllingsgrad i de ulike intervallene mellom innføringen av kablene
```{r}
library(tidyverse)
library(lubridate)
p3 <- vannreservoar |>
  filter(
    prisomrade == "NO2"
  ) |>
  mutate(
    ar = year(dato),
    uke = isoweek(dato),
    periode = case_when(
      ar < 2008 ~ "Før 2008",
      ar < 2020 ~ "2008–2019",
      ar >= 2020 ~ "2020–2024"
    )
  ) |>
  group_by(
    periode,
    uke
  ) |>
  summarise(
    gjennomsnitt = mean(fyllingsgrad, na.rm = TRUE),
    .groups = "drop"
  )

ggplot(
  p3,
  aes(
    x = uke,
    y = gjennomsnitt,
    color = periode
  )
) +
  geom_line(linewidth = 1) +
  labs(
    x = "Uke",
    y = "Gjennomsnittlig fyllingsgrad (%)",
    color = "Periode",
    title = "Gjennomsnittlig magasinfylling i NO2",
    subtitle = "Sammenligning før og etter utbyggingen av utenlandskabler"
  ) +
  scale_x_continuous(
    breaks = c(1, 9, 18, 27, 36, 44, 52),
    labels = c(
      "Jan", "Feb", "Mai", "Jul", "Sep", "Nov", "Des"
    )
  ) +
  theme_minimal()
```


er endringen i fyllingsgraden større når strømprisen er høy? øker eksportert strømpris? Hvordan korrelerer fyllingsgraden med nedbør, samt strømforbruk med temperatur?


